# Synthetic rules in the exact shape usbguard 1.1.x emits for `list-rules`,
# `listDevices`, and `generate-policy`. Every device, id, serial, and hash is
# invented; only the structural quirks observed on real systems are kept:
# root hubs on `usbN` ports, empty serials, empty connect types, names padded
# with trailing spaces, repeated interface entries, rules without via-port.
allow id 1d6b:0002 serial "0000:00:01.0" name "xHCI Host Controller" hash "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" parent-hash "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=" via-port "usb1" with-interface 09:00:00 with-connect-type ""
allow id 1d6b:0003 serial "0000:00:01.0" name "xHCI Host Controller" hash "CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC=" parent-hash "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=" via-port "usb2" with-interface 09:00:00 with-connect-type ""
allow id 1d6b:0002 serial "0000:00:01.0" name "xHCI Host Controller" hash "DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD=" parent-hash "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=" with-interface 09:00:00 with-connect-type ""
allow id 1111:0001 serial "" name "Example Keyboard" hash "EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE=" parent-hash "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" via-port "1-1" with-interface { 03:01:01 03:01:02 } with-connect-type "hotplug"
allow id 1111:0002 serial "" name "Example Receiver" hash "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF=" parent-hash "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" via-port "1-2" with-interface { 03:01:01 03:01:02 03:00:00 } with-connect-type "hotplug"
allow id 2222:0001 serial "0001" name "Example Camera" hash "GGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGGG=" parent-hash "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" via-port "1-6" with-interface { 0e:01:00 0e:02:00 0e:02:00 0e:02:00 fe:01:01 } with-connect-type "not used"
allow id 2222:0002 serial "000000000" name "Example_Wireless" hash "HHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH=" parent-hash "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" with-interface { e0:01:01 e0:01:01 e0:01:01 } with-connect-type "not used"
allow id 3333:0001 serial "0123456789ABCDEF" name "Example Phone" hash "IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII=" parent-hash "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" with-interface { 06:01:01 ff:42:01 } with-connect-type "hotplug"
allow id 4444:0001 serial "0000111122223333" name "Example Disk      " hash "JJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJJ=" parent-hash "CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC=" with-interface 08:06:50 with-connect-type "hotplug"
