# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*~
.directory

# ---------------------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.sublime-workspace
.nvimlog
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Environment & secrets — never commit real credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key
*.p12
*.pfx
secrets.*
credentials.json
.netrc

# ---------------------------------------------------------------------------
# Build output & distribution
# ---------------------------------------------------------------------------
dist/
build/
out/
site/
release/
*.log

# A blanket *.log also swallows test fixtures that happen to be logs - captured
# tool output committed as test data is source, not build output. Add an
# exception per directory that holds such fixtures, e.g.
#   !tests/fixtures/<name>/*.log

# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
.cache/
.tmp/
tmp/
*.tmp

# ---------------------------------------------------------------------------
# Coverage & test artifacts
# ---------------------------------------------------------------------------
coverage/
coverage.xml
htmlcov/
.coverage
.coverage.*
lcov.info
junit.xml

# ---------------------------------------------------------------------------
# Local Makefile overrides (see make/local.mk in the Makefile include chain)
# ---------------------------------------------------------------------------
make/local.mk

# Profile: rust

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
/target/
**/*.rs.bk
*.pdb
# Cargo.lock is committed for binaries and ignored for libraries.
# Uncomment the next line only if this crate is a library.
# Cargo.lock

# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------
# cargo-mutants output
**/mutants.out*/
# Personal scratch space
ignore/
# Claude Code session memory
.remember/
# Flatpak and makepkg build output
build-flatpak/
.flatpak-builder/
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/*.pkg.tar.*
packaging/arch/*.tar.gz

# Other
**/seeds