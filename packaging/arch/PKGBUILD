# Maintainer: onyks <github.tgwp7@aleeas.com>
#
# Arch Linux package for USBGuard GUI. Arch ships the USBGuard D-Bus bridge
# inside the `usbguard` package, but does not enable its service: after
# installing, `sudo systemctl enable --now usbguard.service usbguard-dbus.service`
# (usbguard-gui --diagnose says so if it is needed).
#
# Build from a clone:  makepkg -si   (in this directory)

pkgname=usbguard-gui
pkgver=0.1.0
pkgrel=1
pkgdesc='Desktop interface for USBGuard: see and control which USB devices may connect'
arch=('x86_64' 'aarch64')
url='https://github.com/onyks-os/USBGuardGUI'
license=('MIT')
depends=('gtk4' 'libadwaita' 'usbguard' 'glib2' 'gcc-libs' 'glibc')
optdepends=('polkit: authorization prompts for changes')
makedepends=('cargo')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Filled in at release time: `updpkgsums` after the tag exists.
sha256sums=('SKIP')

prepare() {
    cd "USBGuardGUI-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "USBGuardGUI-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "USBGuardGUI-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --lib
}

package() {
    cd "USBGuardGUI-$pkgver"
    local id=io.github.onyks_os.UsbguardGui
    install -Dm755 target/release/usbguard-gui "$pkgdir/usr/bin/usbguard-gui"
    install -Dm644 "data/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
    install -Dm644 "data/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
    install -Dm644 "data/$id.gschema.xml" "$pkgdir/usr/share/glib-2.0/schemas/$id.gschema.xml"
    install -Dm644 "data/icons/hicolor/scalable/apps/$id.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/$id.svg"
    install -Dm644 "data/icons/hicolor/symbolic/apps/$id-symbolic.svg" \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/$id-symbolic.svg"
    # Shipped inert: installing it is the administrator's decision.
    install -Dm644 packaging/70-usbguard-gui.rules.example \
        "$pkgdir/usr/share/doc/$pkgname/70-usbguard-gui.rules.example"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
