#: data/io.github.onyks_os.UsbguardGui.metainfo.xml.in:75
msgid "The policy rules in the order USBGuard evaluates them"
msgstr "Le regole della policy nell’ordine in cui USBGuard le valuta"

#: data/io.github.onyks_os.UsbguardGui.metainfo.xml.in:79
msgid "A guided editor for new rules"
msgstr "Un editor guidato per le nuove regole"

#: data/io.github.onyks_os.UsbguardGui.metainfo.xml.in:83
