"USBGuard restarts."
msgstr ""
"Da “{old}” a “{new}”. La modifica si applica subito e dura fino al riavvio "
"di USBGuard."

#: src/ui/window.rs:766
msgid "Change"
msgstr "Modifica"

#: src/ui/window.rs:820
msgid "Which rule?"
msgstr "Quale regola?"

